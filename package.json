{
  "name": "arrow-slide-puzzle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nana Pearl's Arrow Slide Puzzle — a deep-violet browser puzzle game.",
  "scripts": {
    "dev": "vite",
